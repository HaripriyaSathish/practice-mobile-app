# ---- Django ----
SECRET_KEY=change-me
DEBUG=True

# ---- MySQL (MySQL Workbench / MySQL80 service) ----
DB_NAME=south_cart_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Email for OTP ----
# Leave EMAIL_HOST_USER empty  -> OTP is printed in the backend terminal (easy for practice)
# Fill these with a Gmail address + Gmail "App Password" -> OTP is really emailed
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Cashfree payment gateway (TEST mode) ----
# Free test keys: Cashfree merchant dashboard -> switch to Test mode -> Developers -> API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Address of this backend used in invoice links inside emails (use your PC's IP to open them on a phone)
SITE_URL=http://127.0.0.1:8001/

# ---- PostgreSQL (Neon) - when set, used instead of the MySQL settings above ----
DATABASE_URL=

# ---- Cloudinary: product / banner / seller photos (required on Render - its disk is wiped on deploy) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend: OTP + order emails over HTTPS (Render blocks Gmail SMTP) ----
RESEND_API_KEY=
# must be on a domain verified at resend.com/domains; onboarding@resend.dev only emails your own Resend login
RESEND_FROM_EMAIL=Vetri Shopping Hall <onboarding@resend.dev>

# ---- SendGrid (Render only - set it in Render's Environment; ignored locally, which uses Gmail SMTP) ----
# SENDGRID_FROM_EMAIL must be a verified Single Sender in SendGrid (defaults to EMAIL_HOST_USER)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
