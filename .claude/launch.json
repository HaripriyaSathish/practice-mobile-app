{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "C:\\practice mobile app\\backend\\venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "C:\\practice mobile app\\backend\\manage.py",
        "runserver",
        "0.0.0.0:8001"
      ],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "C:\\practice mobile app\\backend\\venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "C:\\practice mobile app\\backend\\manage.py",
        "runserver",
        "0.0.0.0:8011",
        "--noreload"
      ],
      "env": {
        "DB_TARGET": "sqlite",
        "CLOUDINARY_FOLDER": "vetri",
        "RESEND_API_KEY": "",
        "EMAIL_HOST_USER": ""
      },
      "port": 8011,
      "autoPort": false
    },
    {
      "name": "frontend-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
