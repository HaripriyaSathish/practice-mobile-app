      ],
      "cwd": "C:\\practice mobile app\\frontend",
      "env": {
        "EXPO_PUBLIC_API_PORT": "8001",
        "BROWSER": "none"
      },
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8083"
      ],
      "cwd": "C:\\practice mobile app\\frontend",
      "env": {
        "EXPO_PUBLIC_API_PORT": "8011",
        "BROWSER": "none"
      },
      "port": 8083,
      "autoPort": false
